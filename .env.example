# ============================================================
# 英语听力短视频生成器 - 环境变量模板
# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 忽略，严禁提交。
# ============================================================

# ---------- 全局默认学段 / 题型 ----------
# 默认学段标识（对应 config/curriculum/<level>.json）
DEFAULT_LEVEL=primary_g4
# 默认题型标识（对应 templates/<question_type>.html）
DEFAULT_TYPE=image_ab_choice

# ---------- 多模态大模型（素材识别 + 分学段文案生成）----------
# 后续接入，先预留统一接口；Base URL 兼容 OpenAI 兼容协议
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# 多模态识别超时（秒）
LLM_TIMEOUT=60

# ---------- 火山引擎 TTS ----------
VOLC_ACCESS_KEY=your_volc_access_key_here
VOLC_SECRET_KEY=your_volc_secret_key_here
# 火山引擎语音合成应用 ID
VOLC_APP_ID=your_volc_app_id_here
# 默认音色（可被学段配置覆盖）
VOLC_VOICE_TYPE=BV001_streaming
# 集群/接入点（按火山引擎文档填写）
VOLC_CLUSTER=volcano_tts

# ---------- 输出与视频默认参数 ----------
OUTPUT_DIR=output
# 竖屏分辨率 宽x高
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
# 每道题英文朗读遍数
DEFAULT_READ_TIMES=2
# 倒计时秒数（听音作答前）
COUNTDOWN_SECONDS=5
# 答案揭晓前等待秒数
REVEAL_DELAY_SECONDS=3
