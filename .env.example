# ============================================================
# 英语听力短视频生成器 - 环境变量模板
# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 忽略，严禁提交。
# ============================================================

# ---------- 全局默认学段 / 题型 ----------
# 默认学段标识（对应 config/curriculum/<level>.json）
DEFAULT_LEVEL=primary_g4
# 默认题型标识（对应 templates/<question_type>.html）
DEFAULT_TYPE=image_ab_choice

# ---------- 多模态大模型（素材识别 + 分学段文案生成）----------
# 后续接入，先预留统一接口；Base URL 兼容 OpenAI 兼容协议
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# 多模态识别超时（秒）
LLM_TIMEOUT=60

# ---------- 火山引擎 TTS（V3 seed-tts-2.0 大模型接口）----------
# 新版控制台「API Key 快速接入」：只需 VOLC_API_KEY + VOLC_RESOURCE_ID
# 旧版 V1 的 APPID + Access Token（Bearer/HMAC256）鉴权已废弃，不再使用
# 获取方式：语音技术控制台 -> 大模型语音合成 -> API Key 管理
VOLC_API_KEY=your_volc_api_key_here
# 资源 ID：seed-tts-2.0 = 豆包语音合成模型 2.0（仅兼容 2.0 音色列表中的发音人）
VOLC_RESOURCE_ID=seed-tts-2.0
# 默认音色：必须为 seed-tts-2.0 兼容音色（可被学段 curriculum.tts.voice_type 覆盖）
VOLC_VOICE_TYPE=zh_female_yingyujiaoxue_uranus_bigtts
# 以下为旧版 V1 鉴权遗留字段，V3 已废弃，可留空
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_APP_ID=
VOLC_TTS_APPID=
VOLC_CLUSTER=volcano_tts

# ---------- 输出与视频默认参数 ----------
OUTPUT_DIR=output
# 画幅方向（可选值：landscape 横屏 / portrait 竖屏），默认 landscape
# 不同电脑可独立设置互不影响；也可通过 CLI --orientation 临时覆盖测试
VIDEO_ORIENTATION=landscape
# 宽高已由 config/layouts.json 按 VIDEO_ORIENTATION 自动决定，无需单独配：
#   landscape → 1920x1080（16:9）
#   portrait  → 1080x1920（9:16）
VIDEO_FPS=30
# 每道题英文朗读遍数
DEFAULT_READ_TIMES=2
# 音频播完后的作答思考倒计时（秒）
COUNTDOWN_SECONDS=3
# 倒计时结束到答案揭晓之间的短暂停顿（秒）
REVEAL_DELAY_SECONDS=1
# 答案揭晓后停留展示原文/翻译/解析的秒数
REVEAL_HOLD_SECONDS=6

# ---------- 开场提示音（考场前奏“叮”）----------
# 是否在每次听力朗读前自动拼接一段提示音 + 停顿（模拟真实考场节奏）
ENABLE_INTRO_SFX=True
# 提示音文件路径（相对项目根，或绝对路径）；纯 Python 合成的 16-bit/44100Hz/单声道 WAV
INTRO_SFX_PATH=assets/sfx/intro_ding.wav
# 提示音播完后停顿几秒再开始朗读英文听力稿
INTRO_SFX_PAUSE_SEC=0.5
